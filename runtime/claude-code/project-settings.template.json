{
  "enabledPlugins": {
    "aeo@aeo-sources": true,
    "ui-ux-pro-max@aeo-sources": true,
    "ponytail@ponytail": false,
    "superpowers@claude-plugins-official": false,
    "vercel-plugin@vercel": false,
    "social-media-skills@synced": false
  },
  "model": "sonnet",
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "4",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "skillOverrides": {
    "ui-ux-pro-max:design": "off",
    "ui-ux-pro-max:design-system": "user-invocable-only",
    "ui-ux-pro-max:brand": "user-invocable-only",
    "ui-ux-pro-max:banner-design": "user-invocable-only",
    "ui-ux-pro-max:slides": "user-invocable-only"
  },
  "permissions": {
    "allow": [
      "Edit(.aeo/**)",
      "Write(.aeo/**)"
    ],
    "ask": [
      "Bash(git commit*)",
      "Bash(git * commit*)",
      "Bash(git merge*)",
      "Bash(git * merge*)",
      "Bash(git rebase*)",
      "Bash(git * rebase*)",
      "Bash(npm install*)",
      "Bash(npm i *)",
      "Bash(npm ci*)",
      "Bash(npm add*)",
      "Bash(pnpm install*)",
      "Bash(pnpm i *)",
      "Bash(pnpm add*)",
      "Bash(pnpm dlx*)",
      "Bash(yarn add*)",
      "Bash(yarn install*)",
      "Bash(bun add*)",
      "Bash(bun install*)",
      "Bash(bunx *)",
      "Bash(pip install*)",
      "Bash(pip3 install*)",
      "Bash(python -m pip install*)",
      "Bash(uv add*)",
      "Bash(uv pip install*)",
      "Bash(cargo add*)",
      "Bash(cargo install*)",
      "Bash(npx *)",
      "Bash(claude plugin*)",
      "Bash(claude config*)",
      "Bash(git config --global*)",
      "Bash(gh issue create*)",
      "Bash(gh label create*)",
      "Bash(glab issue create*)",
      "Bash(glab label create*)",
      "Bash(git remote add*)",
      "Bash(git remote set-url*)"
    ],
    "deny": [
      "Bash(git push*)",
      "Bash(git * push*)",
      "Bash(gh pr merge*)",
      "Bash(git reset*--hard*)",
      "Bash(git * reset*--hard*)",
      "Bash(git clean*)",
      "Bash(git * clean*)",
      "Bash(git branch*-D*)",
      "Bash(git * branch*-D*)",
      "Bash(git checkout*.)",
      "Bash(git restore*.)",
      "Bash(vercel*--prod*)",
      "Bash(vercel promote*)",
      "Edit(~/.claude/**)",
      "Write(~/.claude/**)",
      "Edit(**/.env*)",
      "Write(**/.env*)",
      "Edit(**/*.pem)",
      "Write(**/*.pem)",
      "Edit(.aeo/gates.jsonl)",
      "Write(.aeo/gates.jsonl)",
      "Edit(.aeo/gates.lock)",
      "Write(.aeo/gates.lock)",
      "Bash(*gates.jsonl*)",
      "Bash(*gates.lock*)",
      "Bash(rm *.aeo*)",
      "Bash(* rm *.aeo*)",
      "Bash(mv *.aeo*)",
      "Bash(* mv *.aeo*)",
      "Skill(ui-ux-pro-max:design)"
    ]
  }
}
